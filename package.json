{
  "name": "notion-sync",
  "version": "0.1.1",
  "description": "Opinionated two-way sync from opted-in notes to one Notion data source.",
  "author": "Maurice Frank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morris-frank/notion-sync.git"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.0.0"
  }
}
